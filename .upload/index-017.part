";</script><script>window.SFXD={"note": "data:audio/mpeg;base64,", "btn": "data:audio/mpeg;base64,", "dis": "data:audio/mpeg;base64,", "load": "data:audio/mpeg;base64,", "burst": "data:audio/mpeg;base64,", "menu": "data:audio/mpeg;base64,", "fail": "data:audio/mpeg;base64,", "alert": "data:audio/mpeg;base64,"};window.SFXG={"note": 0.54, "btn": 1.62, "dis": 1.86, "load": 1.32, "burst": 0.4, "menu": 0.62, "fail": 0.46, "alert": 0.6};</script>
<script>
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const RM=matchMedia('(prefers-reduced-motion:reduce)').matches,MOB=()=>innerWidth<=860;
const S=[
{k:'home',m:'',pt:'BRAIN SIGNAL: ACTIVE',nm:'NEXT BIG IDEA<br><i class="nb"> · </i>LOADING...',l:'NEON BAY',o:'FIGURE OUT HOW EVERYTHING WORKS',q:'Curiosity has a terrible sense of scope.'},
{k:'about',m:'ABOUT ME',pt:'PLAYER SCAN: COMPLETE',nm:'BACKSTORY<br><i class="nb"> · </i>UNLOCKED',l:'VIOLET PIER',o:'MEET THE PLAYER',q:'Some tabs are still waiting to become a project.'},
{k:'skills',m:'SKILLS',pt:'SKILL TREE: ACTIVE',nm:'NEXT UPGRADE<br><i class="nb"> · </i>IN PROGRESS',l:'SIGNAL ROOM',o:'UNLOCK THE ABILITIES',q:'Somewhere, another project is being born.'},
{k:'projects',m:'PROJECTS',pt:'PROJECT RADAR: ONLINE',nm:'NEW BUILDS<br><i class="nb"> · </i>DETECTED',l:"BUILDERS' PROMENADE",o:'INSPECT THE BUILDS',q:'Works on my laptop. Also on yours, now.'},
{k:'journey',m:'EXPERIENCE',pt:'TRAJECTORY: SET',nm:'FINAL DESTINATION<br><i class="nb"> · </i>UNKNOWN',l:'SKYLINE OVERLOOK',o:'TRACE THE JOURNEY SO FAR',q:'Big questions. Small laptop. Tabs everywhere.'},
{k:'achievements',m:'ACHIEVEMENTS',pt:'TRAJECTORY: SET',nm:'FINAL DESTINATION<br><i class="nb"> · </i>UNKNOWN',l:'MILESTONE DISTRICT',o:'DOCUMENT THE JOURNEY.',q:'Not a trophy shelf. More of a very honest shelf.'},
{k:'code',m:'ACADEMY',pt:'TRAJECTORY: SET',nm:'FINAL DESTINATION<br><i class="nb"> · </i>UNKNOWN',l:'ORBITAL OBSERVATORY',o:'BUILD. TEST. REPEAT.',q:'Hypothesis: one more experiment won’t hurt.'},
{k:'contact',m:'CONTACT',l:'SUNRISE BOULEVARD',o:'OPEN A LINE OF CONTACT',q:'Replies faster than my tabs load.'},
{k:'mission-complete',m:'EXIT GAME',l:'AFTERGLOW DOCKS',o:'RIDE OFF INTO THE SUNRISE',q:'Credits roll. Curiosity doesn’t.'}];
const G='https://github.com/SatyajitBeura2468/',V=u=>`https://${u}.vercel.app`;
const P=[
{n:'BLACK HOLE: BEURA OBSERVATORY',i:'◉',d:'A standalone WebGL black-hole simulator with an accretion disk, gravitational-lensing effects, photon-ray and time-dilation labs, and adaptive quality for phones and low-end PCs.',demo:'https://blackhole-pocket.vercel.app/',src:G+'BlackHole',st:'LIVE BUILD',c:['live','science'],t:['PHYSICS','BLACK HOLES','WEBGL SIMULATION'],note:'An educational, Schwarzschild-inspired visual model, not a full Kerr ray tracer or real telescope imagery.'},
{n:'PROJECT TEJASVAYU',i:'☀',d:'A student-led TiO₂ photocatalysis concept with an interactive visualisation of air-purification surfaces.',demo:V('project-tejas-vayu'),src:G+'Project-Tejas-Vayu',st:'EARLY-STAGE EDUCATIONAL PROTOTYPE',c:['live','proto','science'],t:['TiO₂ PHOTOCATALYSIS','VISUALISATION','CONCEPT'],note:'Early-stage educational prototype. It makes no claim of calibrated pollutant-removal performance or proven outdoor effectiveness.'},
{n:'GRANTHSETU',i:'▤',d:'A school and community library platform with a public catalogue and organised librarian workflows.',demo:'https://granthsetu.vercel.app/',src:G+'GranthSetu',st:'LIVE BUILD',c:['live'],t:['LIBRARY','SCHOOL TECH','CATALOGUE']},
{n:'LESSONER',i:'✎',d:'A clearer lesson-planning workflow for teachers and principals, from the first draft to the final print-ready plan.',demo:V('lessoner'),src:G+'Lessoner',st:'LIVE BUILD',c:['live'],t:['EDUCATION','WORKFLOW','PRINT-READY']},
{n:'AWSAR SETU V2',i:'✦',d:'Anonymous discovery of schemes, scholarships, grants, internships and other public-interest opportunities, with official-source links.',demo:V('awsar-setu-v2'),src:G+'Awsar-Setu-v2',st:'LIVE BUILD',c:['live'],t:['PUBLIC-INTEREST','DISCOVERY','OFFICIAL LINKS']},
{n:'MIMIC 2D',i:'☺',d:'A playful stealth game about mimicking household objects, fooling inspectors and collecting cookies.',demo:V('mimic2d'),src:G+'MIMIC-2D',st:'LIVE BUILD',c:['live'],t:['GAME','STEALTH','2D']},
{n:'SPLITSNAP',i:'÷',d:'A local-first bill splitter for meals, trips, groups, custom shares and settle-up plans.',demo:'https://splitsnap-teamsatyajitbeura.vercel.app/',src:G+'SplitSnap',st:'LIVE BUILD',c:['live'],t:['LOCAL-FIRST','UTILITY','GROUPS']},
{n:'WINDOWSEAT V2',i:'⛯',d:'An immersive train-window journey through changing Indian landscapes, weather, light, movement and ambient sound.',demo:V('windowseat-v2'),src:G+'windowseat_v2',st:'LIVE BUILD',c:['live'],t:['IMMERSIVE','AMBIENT SOUND','LANDSCAPES']},
{n:'BERNOULLI SIMULATION',i:'≈',d:'An interactive visual explanation of the relationship between fluid speed, pressure and tube geometry.',demo:'https://satyajitbeura2468.github.io/bernoulli-simulation/',src:G+'bernoulli-simulation',st:'LIVE BUILD',c:['live','science'],t:['FLUID DYNAMICS','PHYSICS','SIMULATION']},
{n:'WHAT DID I CATCH?',i:'⚓',d:'A perfectly normal fishing game: cast, reel through five waters, upgrade your gear and collect some suspiciously non-fish catches.',demo:'https://what-did-i-catch.vercel.app/',src:G+'what-did-i-catch',st:'LIVE BUILD',c:['live'],t:['GAME','CANVAS 2D','FISHING']},
{n:'GRAVITY GONE',i:'⇅',d:'A momentum-driven gravity puzzle: swipe to change gravity, dodge mines and slide through 12 neon space mazes.',demo:'https://gravity-gone.vercel.app/',src:G+'GravityGone',st:'LIVE BUILD',c:['live'],t:['GAME','PHYSICS PUZZLE','12 LEVELS']},
{n:'BLACKHOLE DELIVERY',i:'●',d:'You are a black hole with a delivery contract: swallow the order, grow through six size tiers and reach the portal across 16 levels.',demo:'https://blackhole-delivery.vercel.app/',src:G+'Blackhole-Delivery',st:'LIVE BUILD',c:['live'],t:['GAME','PUZZLE','16 LEVELS']},
{n:'HUNGRY PAWS',i:'✺',d:'A playful 3D cat game: explore a neighbourhood, hunt six mice, manage hunger and pounce through an early open-world prototype.',demo:'https://hungry-paws-teamsatyajitbeura.vercel.app/',src:G+'HungryPaws',st:'EARLY PROTOTYPE',c:['live','proto'],t:['3D GAME','THREE.JS','PROTOTYPE'],note:'Early playable prototype: one neighbourhood area is playable and the wider open world is not built yet.'},
{n:'THE LAST SIGNAL',i:'◎',d:'A cinematic deep-space receiver: tune a 10 MHz to 100 GHz band, lock coherent carriers and decode a transmission 14,000 years old.',demo:'https://the-last-signal-eosin.vercel.app/',src:G+'the-last-signal',st:'LIVE BUILD',c:['live'],t:['EXPERIENCE','SIGNAL TUNING','WEB AUDIO'],note:'A fictional, procedurally generated experience, not real telescope data.'},
{n:'HIMLANDS',i:'❄',d:'An alpine fantasy world in development, with snow, traversal, spellcraft and environmental storytelling.',demo:V('himlands-v2'),src:G+'himlands-v2',st:'IN DEVELOPMENT',c:['live','proto'],t:['GAME','ALPINE FANTASY','IN DEVELOPMENT']},
{n:'ASTRASETU',i:'☄',d:'Space-science exploration with mission-control concepts, astronomy, simulations and student tools.',demo:V('astra-setu'),src:G+'AstraSetu',st:'EXPERIMENT',c:['live','science'],t:['ASTRONOMY','SIMULATION','STUDENT TOOLS']},
{n:'THE DYNAMICS',i:'≋',d:'An explorable Bernoulli and Venturi lab with live pressure maps, flow particles, draggable geometry and fluid presets.',demo:'https://the-dynamics.netlify.app',src:G+'3.6_lol',st:'LIVE BUILD',c:['live','science'],t:['FLUID DYNAMICS','PHYSICS','SIMULATION'],note:'An educational, simplified model, not an engineering tool.'},
{n:'TEJASVAYU: THE EXPERIENCE',i:'☼',d:'A cinematic scroll-led story that moves from a polluted city to microscopic activation and cleaner applications at scale.',demo:'https://tejasvayu.vercel.app',src:G+'tejasvayu-experience',st:'LIVE BUILD',c:['live','science'],t:['STORYTELLING','PHOTOCATALYSIS','CONCEPT'],note:'Conceptual visualisation of the TejasVayu idea, not proof of real-world performance.'},
{n:'SATYAAI',i:'✧',d:'A privacy-conscious, local-first AI interface with Fast, Smart and Deep Think modes, honest about what is connected yet.',demo:'https://satyaai-five.vercel.app',src:G+'SatyaAI',st:'EARLY PROTOTYPE · V0.1',c:['live','proto'],t:['AI INTERFACE','LOCAL-FIRST','PRIVACY'],note:'V0.1 is an interface foundation. Without a configured model endpoint it shows a clearly labelled degraded state; live inference, citations and search are not built yet.'},
{n:'TRUSTMODE V2',i:'⛨',d:'Digital help without surrendering control: a helper prepares proposals while the owner keeps their data, authority and final submission.',demo:'https://trustmode-v2.vercel.app',src:G+'Trustmode-v2',st:'LIVE BUILD',c:['live'],t:['SAFETY','ACCESSIBILITY','PROPOSAL-BASED'],note:'Uses fictional workflows and synthetic data only; it makes no real submissions.'},
{n:'TABITAT',i:'⌬',d:'A local-first Chrome extension that turns every open tab into an aquarium creature, with a practical tab-manager list view.',src:G+'tabitat',st:'EXTENSION · UNPACKED BUILD',c:['proto'],t:['CHROME EXTENSION','PRODUCTIVITY','LOCAL-FIRST'],note:'Installed from source as an unpacked Chrome extension; no live demo is linked.'},
{n:'PROTOCOL-2026-OS',i:'⌘',d:'An early gamified life operating system for Class 11 and 12 study, backlogs and board prep.',src:G+'Protocol-2026-OS',st:'EARLY PROTOTYPE · V0.1',c:['proto'],t:['PRODUCTIVITY','STUDENT TOOL','GAMIFIED'],note:'Starting phase: the planned features are ideas, not shipped capabilities.'},
{n:'HOMEPAL',i:'⌂',d:'Household admin in one calm, mobile-first app: rental records, inspections, home care, tasks and recipes stored on your device.',demo:'https://homepal-india.vercel.app/',src:G+'homepal-india',st:'LIVE BUILD',c:['live'],t:['UTILITY','LOCAL-FIRST','MOBILE-FIRST']},
{n:'DIMENSIONAL MEMORY ENCODING',i:'▦',d:'An interactive public explainer of my DME soft-matter study: matched compression histories, pressure maps and a browser lab.',demo:'https://dimensional-memory-encoding.vercel.app/',src:G+'dimensional-memory-encoding',st:'RESEARCH PROJECT',c:['live','science'],t:['RESEARCH','SOFT MATTER','SIMULATION'],note:'Independent exploratory research. Browser simulations are educational reconstructions, not established scientific consensus.'},
{n:'ALGORITHMIC CONVERGENT EVOLUTION',i:'⇆',d:'An interactive research publication on how shared ranking systems may push different media genres toward similar forms.',demo:'https://algorithmic-convergent-evolution.vercel.app',src:G+'algorithmic-convergent-evolution',st:'RESEARCH PROJECT',c:['live'],t:['RESEARCH','DIGITAL MEDIA','SIMULATION'],note:'Independent exploratory research. Results in the interactive lab are synthetic simulation outputs, not observations from a named platform.'}];
const AO=['what-did-i-catch', 'homepal-india', 'MIMIC-2D', 'SplitSnap', 'HungryPaws', 'Blackhole-Delivery', 'GravityGone', 'BlackHole', 'Lessoner', 'SatyaAI', 'GranthSetu', 'tejasvayu-experience', 'algorithmic-convergent-evolution', 'dimensional-memory-encoding', 'himlands-v2', 'Trustmode-v2', 'the-last-signal', '3.6_lol', 'tabitat', 'windowseat_v2', 'AstraSetu', 'Awsar-Setu-v2', 'Protocol-2026-OS', 'Project-Tejas-Vayu', 'bernoulli-simulation'].map(r=>P.findIndex(p=>p.src.endsWith('/'+r)));
const A=[
{n:'PROJECT TEJASVAYU · IIT BHUBANESWAR',i:'◆',d:'Presented at Odiapreneur 3.0 at IIT Bhubaneswar, Project Tejasvayu explored photocatalytic surfaces as a practical approach to urban air-pollution mitigation. The prototype received feedback from industry leaders, alongside encouragement for future guidance from IIT mentors.'},
{n:'GRANTHSETU + LESSONER · REIMAGINING SCHOOL WORKFLOWS',i:'▤',d:'GranthSetu brings institutions and students together through dedicated interfaces for library management, resource discovery, and access. Lessoner empowers teachers with a purpose-built lesson-planning workspace. Both projects address real school-level needs, with the ambition to evolve into adaptable solutions serving educational communities across India and beyond.'},
{n:'AWSAR SETU · PUBLIC-INTEREST TECHNOLOGY',i:'✦',d:'An opportunity-discovery platform designed to help people find relevant government schemes, programmes, and opportunities. Following outreach to the Kalahandi district administration, the project received active interest in its further development. Government API integration remains a key next step toward building a more connected and useful platform.'},
{n:'HIMLANDS · WEBGPU EXPERIMENTATION',i:'❄',d:'An experimental project combining advanced animation, custom shaders, and physics-driven visual effects in the browser. Its distinctive technical presentation attracted attention from AI-curation communities, including @evolving.ai, showcasing how far modern WebGPU experiences can push interactive web graphics.'},
{n:'EVENT HORIZON · FACULTY FEEDBACK',i:'◉',d:'The black-hole simulation received positive feedback from Assistant Professors at Maa Manikeswari University and Ravenshaw University. Neither university has officially endorsed it.'},
{n:'MIMIC 2D · FIRST-HOUR TRACTION',i:'☺',d:'More than 100 local downloads in its first hour after launch.'},
{n:'SPLITSNAP · LOCAL TRACTION',i:'÷',d:'Positive local word-of-mouth for its simplicity and usefulness.'}];
const SK=[['Creative Writing',3],['Prompt Engineering',3],['AI-Assisted Research',3],['Public Speaking & Presentations',3],['Science Communication',2],['Web Development',2],['Interactive Simulations',2],['UI/UX & Product Prototyping',2],['Interdisciplinary Thinking',2],['Scientific Visualisation',1]];
const LB=['','EXPLORING','HANDS-ON','CORE FOCUS'];
const TECH='HTML CSS JavaScript TypeScript React Next.js Python Three.js WebGL GLSL|Canvas&nbsp;2D Supabase/PostgreSQL Vercel Web&nbsp;Audio'.replace('|',' ').split(' ');
const ext=(u,t,c='cta g sm')=>`<a class="${c} fx" href="${u}" target="_blank" rel="noopener noreferrer">${t}</a>`;
const lk=(u,ic,t,s)=>`<a class="lnk fx" data-s href="${u}" target="${u[0]=='m'?'_self':'_blank'}" rel="noopener noreferrer"><em>${ic}</em><span>${t}<small>${s}</small></span></a>`;
const hd=(t,s)=>{let c=0;return `<h2 class="hd${t.length>10?' lg':''}" data-s aria-label="${t}">${t.split(' ').map(w=>`<span class="w" aria-hidden="true">${[...w].map(ch=>`<s style="--c:${c++}">${ch}</s>`).join('')}</span>`).join(' ')}</h2><p class="sub scr" data-s>${s}</p>`};
const okUrl=u=>{if(typeof u!='string'||!u.trim())return false;try{const x=new URL(u.trim());return/^https?:$/.test(x.protocol)&&!!x.hostname}catch(e){return false}};
let pv='m',pf='all',aAll=false;
const R={
home:()=>`<h1 class="brand" data-s><span>SATYAJIT</span><span>BEURA</span><em class="scr">Portfolio</em></h1>
<nav id="menu" data-s aria-label="Main menu">${S.map((s,i)=>i?`<button class="mi fx" data-m="${i}"><span>${s.m}</span><span class="ck" aria-label="visited">✓</span><span class="ch">›</span></button>`:'').join('').replace(/^/,'<button class="mi fx" data-act="start"><span>START GAME</span><span class="ch">›</span></button>')}</nav>
<section class="hero" data-s><p class="mono idl" aria-label="Student researcher · Independent builder"><span>STUDENT RESEARCHER</span><span class="sep" aria-hidden="true"> · </span><span>INDEPENDENT BUILDER</span></p><h2>The universe is weird. I’m investigating.</h2><p>An aspiring astrophysicist, student researcher and independent developer exploring astronomy, physics and AI. I build simulations, experiment with technology and investigate questions that probably could have waited until Monday.</p><button class="cta fx" data-act="start">START GAME</button> <button class="cta g fx" data-go="3">VIEW PROJECTS</button></section>`,
about:()=>hd('ABOUT','The Player Behind the Pixels')+`<p class="body bio" data-s>This is Satyajit Beura, a student from Odisha, aspiring astrobiologist, independent researcher and builder. I’m fascinated by physics, space, biology, genetics and AI, and I love understanding how things work and building projects around what I discover. Chemistry and I are still working on our relationship. Let’s just say it’s complicated.</p><p class="body bio" data-s>One question leads to another, and my project folder has accepted its fate. Connecting the dots is the goal; finding more dots is the usual outcome. My browser tabs have practically formed their own scientific community, and my curiosity has a very questionable sense of boundaries.</p><p class="body bio" data-s>I’m still figuring things out. That’s rather the point. Somewhere between academics, ambitious ideas and being a night owl, I’m trying to learn more, build useful things and occasionally convince myself that sleeping earlier is a fantastic idea.</p>
<ul class="tags" data-s>${['PHYSICS & SPACE','AI & COMPUTATION','SCIENCE SIMULATIONS','PUBLIC-INTEREST TECH','CREATIVE WRITING','BIOLOGY & GENETICS'].map(t=>`<li>${t}</li>`).join('')}</ul><button class="cta fx" data-go="3" data-s>SEE MY BUILDS</button>`,
skills:()=>hd('SKILLS','Unlocked')+SK.map(([n,l],k)=>`<div class="sk ${k<3?'core':''}" data-s><div><b>${n}</b><span class="mono">${LB[l]}</span></div><div class="pips" style="--k:${k}">${[1,2,3].map(j=>`<i class="${j<=l?'f':''}"></i>`).join('')}</div></div>`).join('')+`<p class="lvl mono" data-s>CURRENTLY LEVELING UP</p><div class="sk up" data-s><div><b>Critical Thinking</b><span class="mono">IN PROGRESS</span></div><i class="ind"></i></div><div class="sk up" data-s><div><b>Metacognition</b><span class="mono">IN PROGRESS</span></div><i class="ind"></i></div>`+`<div class="chips" data-s>${TECH.map(t=>`<span>${t}</span>`).join('')}</div>`,
projects:()=>{const arc=pv=='a',L=arc?AO.map(i=>[P[i],i]).filter(([p])=>pf=='all'||(pf=='live'?okUrl(p.demo):p.c.includes(pf))):P.slice(0,4).map((p,i)=>[p,i]);
return hd('PROJECTS','Showcase')+(arc?`<div class="flt" data-s role="group" aria-label="Filter projects">${[['all','ALL'],['live','LIVE BUILDS'],['proto','PROTOTYPES'],['science','SCIENCE']].map(([k,t])=>`<button class="fx" data-f="${k}" aria-pressed="${pf==k}">${t}</button>`).join('')}</div>`:'')+L.map(([p,i])=>`<button class="row fx" data-s data-p="${i}"><span class="ic">${p.i}</span><span><b>${p.n}</b><span class="d">${arc?p.st:p.d}</span></span><span class="go">›</span></button>`).join('')+(arc?`<button class="cta g fx" data-s data-act="back">‹ BACK TO MISSIONS</button>`:`<button class="cta fx" data-s data-act="all">VIEW ALL PROJECTS ›</button>`)},
journey:()=>hd('EXPERIENCE','The Journey So Far')+`<div class="tl">${[['THE QUESTIONS BEGAN','Childhood','It started with looking at the night sky and asking questions. Unfortunately, the universe had a lot of them.'],['ONE THING LED TO ANOTHER','Now','Somewhere between studying science, exploring AI, and asking one question too many, I started building apps, simulations, and research projects. Apparently, having one interest was never an option. My project folder has accepted its fate.'],['BEYOND THE UNKNOWN','Next','Explore the science of life beyond Earth, develop stronger research skills, and build tools that help turn big questions into testable ideas.']].map(([a,b,c])=>`<div class="st3" data-s><div class="mono">${b.toUpperCase()}</div><h3>${a}</h3><p>${c}</p></div>`).join('')}</div><p class="aside scr" data-s>Still early in the campaign. The map is loading.</p>`,
achievements:()=>hd('ACHIEVEMENTS','Unlocked')+A.slice(0,aAll?7:4).map((a,i)=>`<button class="row done fx" data-s data-a="${i}"><span class="ic">${a.i}</span><span><b>${a.n}</b><span class="d">${a.d.split('. ')[0].replace(/\.$/,'')}.</span></span><span class="go">›</span></button>`).join('')+(aAll?'':`<button class="cta fx" data-s data-act="ms">VIEW ALL MILESTONES</button>`),
code:()=>hd('CODE CONSTELLATION','Playground of Possibilities')+`<div class="card" data-s><span class="chip">LIVE BUILD</span><h3>MIMIC 2D</h3><p>A playful stealth game about mimicking household objects, fooling inspectors and collecting cookies.</p><div class="acts">${ext(V('mimic2d'),'DEMO')}${ext(G+'MIMIC-2D','CODE')}</div></div>
<div class="card" data-s><span class="chip o">IN DEVELOPMENT</span><h3>HIMLANDS</h3><p>An alpine fantasy experience in development, with snow, traversal, spellcraft and environmental storytelling.</p><div class="acts">${ext(V('himlands-v2'),'DEMO / BETA')}${ext(G+'himlands-v2','CODE')}</div></div>
<div class="card" data-s><span class="chip o">EXPERIMENT</span><h3>ASTRASETU</h3><p>Space-science exploration featuring mission-control concepts, astronomy, simulations and student tools.</p><div class="acts">${ext(V('astra-setu'),'DEMO')}${ext(G+'AstraSetu','CODE')}</div></div>
<div class="card" data-s><span class="chip o">IDEA</span><h3>NEXT EXPERIMENTS</h3><p>Ideas for future interactive physics visualisations, stronger validation of research simulations and new ways to make complex ideas approachable.</p></div>
<div class="card" data-s style="border-left-color:var(--cy)"><span class="mono" style="color:var(--cy)">RESEARCH SHELF</span>
<div style="margin-top:8px"><span class="mono" style="color:var(--pk)">THEORETICAL FRAMEWORK · DIGITAL MEDIA</span><p style="margin:2px 0 8px"><b>Algorithmic Convergent Evolution (ACE): A Proposed Theoretical Framework for Digital Media.</b> A proposed framework examining how ranking systems may push different media formats toward similar high-retention patterns.</p><div class="acts">${ext('https://doi.org/10.5281/zenodo.18138541','PAPER')}${ext('https://medium.com/@satyajitbeura/convergent-theory-by-satyajit-beura-the-maths-the-mathematics-of-going-viral-b6383dfc59a9','READ ACE')}</div></div>
<div style="margin-top:14px"><span class="mono" style="color:var(--pk)">EXPLORATORY INVESTIGATION · NON-EQUILIBRIUM PHYSICS</span><p style="margin:2px 0 8px"><b>Transient Memory via Local Pressure Heterogeneity in Non-Equilibrium Systems.</b> An exploratory investigation into whether evolving local pressure differences and flow patterns can preserve short-lived traces of earlier states, connected to my DME research thread.</p><div class="acts">${ext('https://doi.org/10.5281/zenodo.17943112','PAPER')}${ext('https://medium.com/@satyajitbeura/the-future-of-dimensional-memory-encoding-b599a8b8f67b','READ DME')}</div></div>
<div style="margin-top:14px"><span class="mono" style="color:var(--pk)">BIOMEDICAL PROPOSAL · OCULAR DRUG DELIVERY</span><p style="margin:2px 0 8px"><b>“Why the Human Eye is a Fortress (And How We Finally Broke In)”</b><br><i>Synthetic Exosomes: The Future of Non-Invasive Ocular Drug Delivery.</i> A proposal for a fully synthetic solid-lipid-nanoparticle route to non-invasive eye-drop delivery toward the back of the eye, aimed at retinoblastoma. It requires experimental validation and is not an established or clinically validated treatment.</p><div class="acts">${ext('https://doi.org/10.5281/zenodo.19456149','PAPER')}${ext('https://medium.com/@satyajitbeura/why-the-human-eye-is-a-fortress-and-how-we-finally-broke-in-e8c803311a4e','READ ARTICLE')}</div><p class="note">Paper: Zenodo preprint “From Porcine to Synthetic: Overcoming Translational Hurdles in Exosome-Mediated Ocular Drug Delivery”.</p></div>
<p class="note">Independent exploratory research, not established scientific consensus.</p></div>${ext('https://medium.com/@satyajitbeura','READ THE NOTES','cta fx')}`,
contact:()=>hd('CONTACT','Let’s Connect')+lk('mailto:subhadrarout80@gmail.com','✉','EMAIL','subhadrarout80@gmail.com')+lk(G.slice(0,-1),'⌥','GITHUB','github.com/SatyajitBeura2468')+lk('https://medium.com/@satyajitbeura','✎','MEDIUM','medium.com/@satyajitbeura')+lk('https://doi.org/10.5281/zenodo.18138541','⚛','RESEARCH','ACE · DME · OCULAR · OSF · ORCID')+`<div class="q" data-s>${[['ACE','https://doi.org/10.5281/zenodo.18138541'],['DME','https://doi.org/10.5281/zenodo.17943112'],['OCULAR','https://doi.org/10.5281/zenodo.19456149'],['OSF','https://osf.io/qjy3g/'],['ORCID','https://orcid.org/0009-0006-4471-2845']].map(([t,u])=>`<a href="${u}" target="_blank" rel="noopener noreferrer">${t}</a>`).join('')}</div>`+lk('https://youtube.com/@satyajitbeura_factscheck','▶','YOUTUBE','@satyajitbeura_factscheck')+`<a class="cta fx" data-s href="mailto:subhadrarout80@gmail.com?subject=${encodeURIComponent('Hello from your portfolio')}&body=${encodeURIComponent('Hi Satyajit,\n\n')}">SEND A MESSAGE</a>`,
'mission-complete':()=>`<div class="mc"><p class="mono" data-s>THANK YOU FOR VISITING</p><h2 class="hd" data-s style="font-size:clamp(52px,8vw,120px)">MISSION<br>COMPLETE</h2><p class="sub scr" data-s>See you soon!</p><button class="cta fx" data-s data-act="home">BACK TO HOME</button></div>`};
// ---------- state ----------
let cur=-1,visited=new Set(),xpNow=0,flip=0,lock=0;
try{visited=new Set(JSON.parse(sessionStorage.getItem('sb')||'[]'))}catch(e){}
const BG=$$('.bgl'),panel=$('#panel'),dlg=$('#dlg');
let sfx=true,ac;try{sfx=sessionStorage.getItem('sf')!='0'}catch(e){}
const SB={};
let sfxLive=false;
function sfxLbl(){const b=$('#sfx');if(!b)return;const on=sfx&&sfxLive;b.textContent='SFX '+(on?'ON':'OFF');b.setAttribute('aria-pressed',on)}
function sfxInit(e){if(!(e&&e.target&&e.target.closest&&e.target.closest('#sfx'))&&!sfxLive){sfxLive=true;sfxLbl()}if(ac)return;try{ac=new(window.AudioContext||window.webkitAudioContext)();ac.resume&&ac.resume();for(const k in (window.SFXD||{})){const b64=SFXD[k].split(',')[1],bin=atob(b64),u=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);ac.decodeAudioData(u.buffer,x=>SB[k]=x,()=>{})}}catch(e){}}
function sfxp(k,v=1,r=1,jit=0){if(!sfx||!ac||!SB[k])return;try{if(ac.state=='suspended')ac.resume();const s=ac.createBufferSource(),g=ac.createGain();s.buffer=SB[k];s.playbackRate.value=r*(1+(Math.random()-.5)*jit);g.gain.value=Math.min(1.4,(SFXG[k]||1)*v*.85);s.connect(g).connect(ac.destination);s.start()}catch(e){}}
['pointerdown','keydown','touchend'].forEach(x=>addEventListener(x,sfxInit,{passive:true}));
const beep=()=>{};
const buzz=n=>{try{navigator.vibrate&&navigator.vibrate(n)}catch(e){}};
const IM=k=>window.IMG&&IMG[k]||'';
Object.keys(window.IMG||{}).forEach(k=>{const i=new Image();i.src=IMG[k];i.decode&&i.decode().catch(()=>{})});
const bgp=i=>MOB()?(i==4?'22%':'74%')+' 30%':'68% 40%';
function setBg(i,d=1){flip^=1;const e=BG[flip],o=BG[flip^1];e.style.transition='none';e.style.setProperty('--sx',d*5+'%');void e.offsetWidth;e.style.transition='';e.style.setProperty('--sx','0%');o.style.setProperty('--sx',-d*5+'%');e.style.backgroundImage=`url(${IM(S[i].k)})`;e.style.backgroundPosition=bgp(i);e.classList.remove('on');void e.offsetWidth;e.classList.add('on');o.classList.remove('on')}
// minimap
const rt=$('#rt'),RL=rt.getTotalLength(),WP=S.map((_,i)=>rt.getPointAtLength(RL*i/8));
$('#wp').innerHTML=WP.map((p,i)=>`<circle data-w="${i}" cx="${p.x}" cy="${p.y}" r="2.6" fill="#1a0b3a" stroke="#27e6ff"/>`).join('');
let md=0,mraf;
function moveMk(i){cancelAnimationFrame(mraf);const a=md,b=i/8,t0=performance.now(),D=RM?1:900;(function f(t){const k=Math.min(1,(t-t0)/D),e=1-Math.pow(1-k,3);md=a+(b-a)*e;const p=rt.getPointAtLength(RL*md);$('#mk').setAttribute('transform',`translate(${p.x} ${p.y})`);if(k<1)mraf=requestAnimationFrame(f)})(t0)}
function type(el,t){clearInterval(el._t);if(RM){el.textContent=t;return}let n=0;el.textContent='';el._t=setInterval(()=>{el.textContent=t.slice(0,++n);if(n>=t.length)clearInterval(el._t)},22)}
let qOn=false;
function updMore(){const m=MOB()&&panel.scrollHeight-panel.clientHeight-panel.scrollTop>16;$('#more').classList.toggle('on',!!m)}
panel.addEventListener('scroll',()=>{document.body.classList.toggle('sc',MOB()&&panel.scrollTop>24);updMore()},{passive:true});
new MutationObserver(()=>{setTimeout(updMore,400);setTimeout(updMore,1400)}).observe(panel,{childList:true});addEventListener('resize',updMore);
function fitBot(){document.documentElement.style.setProperty('--bh',MOB()?($('#bot').offsetHeight+4)+'px':'');}

function fitQt(on){qOn=on;const q=$('#qt');q.style.fontSize='';q.style.whiteSpace=on?'nowrap':'';q.style.maxWidth=on?'none':'';q.style.minWidth=on?'0':'';if(!on)return;const l=$('#loc').getBoundingClientRect(),av=MOB()?innerWidth*.94-88:innerWidth*.97-l.right-24;const tw=()=>{const g=document.createRange();g.selectNodeContents(q);return g.getBoundingClientRect().width};let s=parseFloat(getComputedStyle(q).fontSize);while(tw()>av&&s>10){s-=.5;q.style.fontSize=s+'px'}}
let obTxt='';
function fitOb(){const el=$('#ob');el.style.fontSize='';el.style.whiteSpace='';if(!MOB()||!obTxt)return;const cur=el.textContent;el.textContent=obTxt;el.style.whiteSpace='nowrap';const av=$('#obw').clientWidth-$('#map').getBoundingClientRect().width-16;let s=parseFloat(getComputedStyle(el).fontSize);while(el.scrollWidth>av&&s>9){s-=.5;el.style.fontSize=s+'px'}el.textContent=cur}
function obT(x){obTxt=x;fitOb();type($('#ob'),x)}
function hudTop(i){const tl=$('#tl');tl.innerHTML=i?`<button class="mini fx" data-act="home" aria-label="Satyajit Builds, back to main menu">SATYAJIT <i>BUILDS</i></button><button class="pb mono fx" data-act="home">MENU</button><button class="pb mono fx" data-act="prev" aria-label="Previous section">‹</button><button class="pb mono fx" data-act="next" aria-label="Next section">›</button>`:'';$('#esc').style.visibility=i?'visible':'hidden'}
function xp(n){const el=$('#xp'),a=xpNow,t0=performance.now();xpNow=n;(function f(t){const k=RM?1:Math.min(1,(t-t0)/700);el.textContent='XP '+Math.round(a+(n-a)*k);if(k<1)requestAnimationFrame(f)})(t0);const r=n>=600?2:n>=300?1:0;$$('#rank span').forEach((s,j)=>s.classList.toggle('on',j==r))}
function anim(el,c,ms){el.classList.remove(c);void el.offsetWidth;el.classList.add(c);clearTimeout(el._a);el._a=setTimeout(()=>el.classList.remove(c),ms)}
function go(i,o={}){if(i<0||i>8||(i==cur&&!o.force))return;const dir=i>cur?1:-1,first=cur<0,fresh=i>=1&&i<=7&&!visited.has(i);cur=i;document.body.classList.toggle('home',i==0);
 const render=()=>{panel.classList.toggle('home',i==0);panel.innerHTML=R[S[i].k]();$$('[data-s]',panel).forEach((e,j)=>e.style.setProperty('--i',j));panel.scrollTop=0;panel.classList.remove('out');
  $$('.pips i.f',panel).forEach(()=>{});requestAnimationFrame(()=>{$$('.pips',panel).forEach(p=>p.classList.add('x'))});sync()};
 const sync=()=>{$$('.mi[data-m]',panel).forEach(b=>b.classList.toggle('v',visited.has(+b.dataset.m)))};
 panel.style.setProperty('--dx',dir);const sw=$('#sw');sw.style.setProperty('--a',dir>0?'100%':'-100%');sw.style.setProperty('--b',dir>0?'-100%':'100%');
 if(first){render()}else{panel.classList.add('out');anim(sw,'go',900);setTimeout(render,RM?0:260)}
 setBg(i,dir);hudTop(i);$('#lc').textContent=S[i].l;$('#pt').textContent=S[i].pt||'SIGNAL 100.3';$('#nm').innerHTML=S[i].nm||'NEXT MILESTONE<br><i class="nb"> · </i>IN PROGRESS';obT(S[i].o);const q=$('#qt');q.style.opacity=0;setTimeout(()=>{q.textContent=S[i].q;q.style.opacity=1;fitQt(true);fitBot()},250);moveMk(i);
 document.title=(i?S[i].m.replace(/^./,c=>c)+' · ':'')+'Satyajit Builds';
 if(fresh){visited.add(i);try{sessionStorage.setItem('sb',JSON.stringify([...visited]))}catch(e){}xp(visited.size*100);setTimeout(()=>{$('#toast').textContent='MISSION LOGGED · +100 XP';anim($('#toast'),'go',2700);$('#badge').textContent='◆ SECTOR UNLOCKED';anim($('#badge'),'go',3100);sfxp('note',.9)},700)}
 else if(i==8){setTimeout(()=>{sfxp('alert',.75);$('#badge').textContent='◆ MISSION PASSED';anim($('#badge'),'go',3100)},700)}
 else if(first)xp(visited.size*100);
 $$('#wp circle').forEach((c,j)=>c.setAttribute('fill',visited.has(j)?'#27e6ff':'#1a0b3a'));
 if(!o.silent){sfxp('dis',.8);buzz(12)}}
const step=d=>{const n=Math.max(0,Math.min(7,(cur==8?0:cur)+d));if(n===cur){sfxp('fail',.55);buzz(28);return}if(cur==8&&d<0)return go(7);go(n)};
function start(){const b=$('#boot');b.classList.add('on');sfxp('load',.9);setTimeout(()=>{b.classList.remove('on');go(1)},RM?50:1250)}
function open(html,fl=0){dlg.innerHTML=`<button class="x fx" data-act="close" aria-label="Close details">✕</button>`+html;dlg.showModal();$('.x',dlg).blur();sfxp('burst',.6)}
function proj(i){const p=P[i];open(`<div class="vis" aria-hidden="true">${p.i}</div><div class="mono" style="color:var(--gn)">${p.st}</div><h3 id="dt">${p.n}</h3><p>${p.d}</p><ul class="tags">${p.t.map(t=>`<li>${t}</li>`).join('')}</ul>${p.note?`<p class="note">${p.note}</p>`:''}<div class="acts">${okUrl(p.demo)?ext(p.demo,'LIVE DEMO','cta fx'):''}${ext(p.src,'SOURCE CODE')}</div>`)}
function ach(i){const a=A[i];open(`<div class="vis" aria-hidden="true">${a.i}</div><div class="mono" style="color:var(--gn)">MILESTONE LOGGED</div><h3 id="dt">${a.n}</h3><p>${a.d}</p>`)}
// ---------- events ----------
document.addEventListener('pointerdown',e=>{const b=e.target.closest('.fx');if(!b)return;const r=b.getBoundingClientRect();b.style.setProperty('--rx',e.clientX-r.left+'px');b.style.setProperty('--ry',e.clientY-r.top+'px');b.classList.remove('rp');void b.offsetWidth;b.classList.add('rp');if(!b.classList.contains('mi'))sfxp('btn',.75,1,.08);buzz(8)});
document.addEventListener('click',e=>{const t=e.target.closest('[data-go],[data-m],[data-act],[data-p],[data-a],[data-f]');if(e.target===dlg)return dlg.close();if(!t)return;
 if(t.dataset.go)return go(+t.dataset.go);if(t.dataset.m)return go(+t.dataset.m);
 if(t.dataset.p!=null)return proj(+t.dataset.p);if(t.dataset.a!=null)return ach(+t.dataset.a);
 if(t.dataset.f){pf=t.dataset.f;sfxp('burst',.45,1.15);return go(3,{force:1,silent:1})}
 const a=t.dataset.act;({start,home:()=>go(0,{force:cur==0}),exit:()=>go(8),close:()=>dlg.close(),prev:()=>step(-1),next:()=>step(1),all:()=>{sfxp('burst',.7);pv='a';pf='all';go(3,{force:1,silent:1})},back:()=>{sfxp('menu',.7);pv='m';go(3,{force:1,silent:1})},ms:()=>{sfxp('burst',.7);aAll=true;go(5,{force:1,silent:1})},mus:()=>{if(musOn){mus=false;musOn=false;fade(0)}else{mus=true;playM()}try{sessionStorage.setItem('mu',mus?'1':'0')}catch(e){}muBtn()},sfx:()=>{if(!sfxLive){sfxLive=true;if(!ac)sfxInit()}else sfx=!sfx;try{sessionStorage.setItem('sf',sfx?'1':'0')}catch(e){}sfxLbl();sfxp('btn',.8)}})[a]()});
document.addEventListener('mouseover',e=>{const m=e.target.closest('.mi');if(m&&document.activeElement!==m){m.focus({preventScroll:true});sfxp('menu',.5,1,.06)}});
addEventListener('keydown',e=>{if(dlg.open||e.metaKey||e.ctrlKey||e.altKey)return;const k=e.key;
 if(k=='Escape'){if(cur>0)go(0)}
 else if(cur==0&&(k=='ArrowDown'||k=='ArrowUp')){const m=$$('.mi'),i=m.indexOf(document.activeElement),n=(i+(k=='ArrowDown'?1:-1)+m.length)%m.length;m[i<0?(k=='ArrowDown'?0:m.length-1):n].focus();sfxp('menu',.55,1,.06);e.preventDefault()}
 else if(k=='ArrowRight'||k=='PageDown'){if(!(e.target.closest&&e.target.closest('input')))step(1)}
 else if(k=='ArrowLeft'||k=='PageUp')step(-1);
 else if(k=='ArrowDown'&&cur>0&&panel.scrollHeight<=panel.clientHeight+4)step(1);
 else if(k=='ArrowUp'&&cur>0&&panel.scrollHeight<=panel.clientHeight+4)step(-1)});
let acc=0,at;
addEventListener('wheel',e=>{if(dlg.open||cur==8)return;const dn=e.deltaY>0;if(e.target.closest('#panel')&&panel.scrollHeight>panel.clientHeight+4&&(dn?panel.scrollTop+panel.clientHeight<panel.scrollHeight-3:panel.scrollTop>3))return;
 acc+=e.deltaY;clearTimeout(at);at=setTimeout(()=>acc=0,220);if(Math.abs(acc)>110&&performance.now()>lock){lock=performance.now()+1000;acc=0;step(dn?1:-1)}},{passive:true});
let tx,ty;addEventListener('touchstart',e=>{tx=e.touches[0].clientX;ty=e.touches[0].clientY},{passive:true});
addEventListener('touchend',e=>{if(dlg.open||tx==null)return;const dx=e.changedTouches[0].clientX-tx,dy=e.changedTouches[0].clientY-ty;tx=null;if(Math.abs(dx)>70&&Math.abs(dx)>Math.abs(dy)*1.6){learned=true;try{sessionStorage.setItem('sl','1')}catch(e){}step(dx<0?1:-1)}},{passive:true});
addEventListener('pointermove',e=>{if(RM)return;const s=$('#bg').style;s.setProperty('--px',(e.clientX/innerWidth-.5).toFixed(3));s.setProperty('--py',(e.clientY/innerHeight-.5).toFixed(3))});
addEventListener('resize',()=>{fitOb();fitBot();if(qOn)fitQt(true);if(cur>=0)BG[flip].style.backgroundPosition=bgp(cur)});
const clk=()=>$('#clk').textContent=new Date().toLocaleTimeString([],{hour12:false});clk();setInterval(clk,1000);
dlg.addEventListener('close',()=>sfxp('menu',.6,.85));
// ---- looping background music (starts on first touch/key; toggle in HUD) ----
const bgm=$('#bgm');let mus=true;try{mus=sessionStorage.getItem('mu')!='0'}catch(e){}
if(window.BGM)bgm.src=BGM;bgm.volume=0;
let musOn=false;
function muBtn(){const b=$('#mus');b.textContent='MUSIC '+(musOn?'ON':'OFF');b.setAttribute('aria-pressed',musOn)}muBtn();
function fade(to,ms=1400){clearInterval(bgm._f);const s=bgm.volume,t0=performance.now();bgm._f=setInterval(()=>{const k=Math.min(1,(performance.now()-t0)/ms);bgm.volume=Math.max(0,Math.min(1,s+(to-s)*k));if(k>=1){clearInterval(bgm._f);if(!to)bgm.pause()}},50)}
function playM(){if(!mus||!bgm.src)return Promise.resolve();return bgm.play().then(()=>{musOn=true;muBtn();fade(.5)}).catch(()=>{})}
const UE=['pointerdown','keydown','touchend'];
const unlock=e=>{if(!mus||musOn||(e&&e.target&&e.target.closest&&e.target.closest('#mus')))return;playM().then(()=>{if(musOn)UE.forEach(x=>removeEventListener(x,unlock))})};
UE.forEach(x=>addEventListener(x,unlock,{passive:true}));
document.addEventListener('visibilitychange',()=>{if(document.hidden)bgm.pause();else if(musOn&&bgm.volume>0)bgm.play().catch(()=>{})});
// swipe hint + idle nudge (touch only)
const touchy=()=>matchMedia('(pointer:coarse)').matches||MOB();let learned=false,hn=0,idle;
try{learned=sessionStorage.getItem('sl')=='1'}catch(e){}
function hint(force){if(learned||dlg.open||cur<1||cur>7||!touchy())return;if(!force&&hn>=2)return;hn++;sfxp('alert',.3);anim($('#hint'),'go',4800);const n=$('[data-act=next]');if(n)anim(n,'nudge',3200)}
function arm(){clearTimeout(idle);if(cur>=1&&cur<=7)idle=setTimeout(()=>hint(true),cur==1?1600:8500)}
['pointerdown','touchstart','keydown','wheel'].forEach(ev=>addEventListener(ev,()=>{if(ev!='wheel'||1)arm()},{passive:true}));
new MutationObserver(arm).observe($('#lc'),{childList:true});
addEventListener('touchend',e=>{if(tx==null&&!learned){}},{passive:true});
window.__enter=()=>{if(window.__ent)return;window.__ent=1;go(0)};
try{document.fonts.ready.then(()=>setTimeout(()=>{fitOb();if(qOn)fitQt(true);fitBot()},50))}catch(e){}
</script>
</body></html>
